{
    "name": "@sigx/actors-surreal",
    "version": "0.9.2",
    "description": "SurrealDB 3 providers for @sigx/actors — etag-CAS actor storage, host membership, the distributed actor directory and durable reminders",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": ["dist", "CHANGELOG.md"],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": ["sigx", "actors", "virtual-actors", "cluster", "surrealdb", "surreal"],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git",
        "directory": "packages/actors-surreal"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "devDependencies": {
        "@sigx/actors": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "surrealdb": "^2.0.8",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/actors": "^0.9.2",
        "surrealdb": "^2.0.8"
    }
}
