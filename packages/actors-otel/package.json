{
    "name": "@sigx/actors-otel",
    "version": "0.9.2",
    "description": "Observability exporters for @sigx/actors — Prometheus text exposition, OpenTelemetry traces and a metrics bridge",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        },
        "./prometheus": {
            "types": "./dist/prometheus.d.ts",
            "development": "./dist/prometheus.js",
            "production": "./dist/prometheus.prod.js",
            "import": "./dist/prometheus.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "actors",
        "virtual-actors",
        "observability",
        "prometheus",
        "opentelemetry",
        "traces",
        "metrics"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git",
        "directory": "packages/actors-otel"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "devDependencies": {
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/sdk-metrics": "^2.0.0",
        "@opentelemetry/sdk-trace-base": "^2.0.0",
        "@sigx/actors": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@opentelemetry/api": ">=1.9",
        "@sigx/actors": "^0.9.2"
    },
    "peerDependenciesMeta": {
        "@opentelemetry/api": {
            "optional": true
        }
    }
}
