{
    "name": "@sigx/actors-ws",
    "version": "0.5.0",
    "description": "WebSocket transport for @sigx/actors \u2014 host-to-host frames over one port, proxy-friendly",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "actors",
        "virtual-actors",
        "cluster",
        "websocket",
        "transport"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git",
        "directory": "packages/actors-ws"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "devDependencies": {
        "@sigx/actors": "workspace:*",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.2.0",
        "ws": "^8.21.2",
        "@types/ws": "^8.5.13"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/actors": "^0.5.0",
        "ws": ">=8"
    }
}
