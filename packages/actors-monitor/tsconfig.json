{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        // DOM for the web platform types this package genuinely uses —
        // `fetch`, `Response`, `AbortSignal`. Not for JSX: there is no JSX
        // here, and there never will be. That is the point of the package.
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "moduleResolution": "bundler",
        "strict": true,
        "types": ["node"],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
