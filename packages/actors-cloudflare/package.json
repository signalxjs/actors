{
    "name": "@sigx/actors-cloudflare",
    "version": "0.2.0",
    "description": "Cloudflare Durable Objects backend for @sigx/actors — one DO per actor",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "production": "./dist/index.prod.js",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && vite build --mode prod-dist && tsc --emitDeclarationOnly",
        "dev": "vite build --watch",
        "test:workers": "vitest run --config vitest.workers.config.ts"
    },
    "keywords": [
        "sigx",
        "actors",
        "virtual-actors",
        "cloudflare",
        "durable-objects",
        "workers"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git",
        "directory": "packages/actors-cloudflare"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "devDependencies": {
        "@cloudflare/vitest-pool-workers": "^0.19.0",
        "@cloudflare/workers-types": "^5.20260729.1",
        "@sigx/actors": "workspace:*",
        "@sigx/vite": "catalog:",
        "typescript": "^6.0.3",
        "vite": "^8.0.3",
        "wrangler": "^4.115.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "@sigx/actors": "^0.2.0"
    }
}
