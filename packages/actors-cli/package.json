{
    "name": "@sigx/actors-cli",
    "version": "0.6.0",
    "description": "sigx CLI plugin for @sigx/actors — observe and monitor hosts, actors and clusters from the terminal",
    "type": "module",
    "main": "./dist/plugin.js",
    "types": "./dist/plugin.d.ts",
    "exports": {
        ".": {
            "types": "./dist/plugin.d.ts",
            "import": "./dist/plugin.js"
        },
        "./source": {
            "types": "./dist/source/index.d.ts",
            "import": "./dist/source.js"
        }
    },
    "sigx-cli": {
        "plugin": "./dist/plugin.js",
        "requires": ">=0.9.0"
    },
    "files": [
        "dist",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && tsc --emitDeclarationOnly",
        "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
        "dev": "vite build --watch"
    },
    "keywords": [
        "sigx",
        "sigx-cli-plugin",
        "actors",
        "virtual-actors",
        "observability",
        "monitoring",
        "tui",
        "dashboard"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git",
        "directory": "packages/actors-cli"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "dependencies": {
        "@sigx/terminal": "^0.12.0"
    },
    "peerDependencies": {
        "@sigx/actors": "^0.6.0",
        "@sigx/cli": ">=0.10.0"
    },
    "peerDependenciesMeta": {
        "@sigx/actors": {
            "optional": true
        }
    },
    "devDependencies": {
        "@sigx/actors": "workspace:*",
        "@sigx/args": "^0.12.0",
        "@sigx/cli": "^0.10.0",
        "@sigx/vite": "catalog:",
        "@types/node": "^25.9.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.3"
    },
    "publishConfig": {
        "access": "public"
    }
}
