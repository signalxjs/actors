# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
docs/dist/
*.d.ts
*.d.ts.map
# Hand-written ambient declarations are SOURCE, at any depth
# (e.g. src/vite/virtual.d.ts declaring `virtual:sigx-actors`).
!packages/*/src/**/*.d.ts
!examples/*/src/**/*.d.ts
*.js
*.js.map

# Keep specific JS files
!vite.config.js
!*.config.js
!examples/*.js
!scripts/*.js

# TypeScript cache
*.tsbuildinfo

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/

# Runtime data (fileStorage of running examples/dev hosts)
.actors/

# Benchmark output. Results and the local baseline are machine-specific —
# only benchmarks/BASELINES.md (hand-curated, with its machine recorded) is
# committed. Heap snapshots and .cpuprofile files are large and disposable.
benchmarks/results/
benchmarks/baselines/
benchmarks/profiles/

# Misc
.cache/
.temp/
.tmp/
.wrangler/
.dev.vars
.mf/
examples/cf-workers/.wrangler/
