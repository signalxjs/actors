{
  "name": "sigx-actors-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Orleans-style virtual actors for SignalX",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "verify:catalog": "node scripts/check-catalog.mjs",
    "wt": "node scripts/worktree.mjs",
    "branch-protection": "node scripts/apply-branch-protection.mjs",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint packages/actors/src",
    "lint:fix": "oxlint --fix packages/actors/src",
    "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:all": "node scripts/publish.js",
    "publish:beta": "node scripts/publish.js --tag beta",
    "version:set": "node scripts/bump-version.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "verify:pack": "node scripts/verify-pack.js",
    "size": "size-limit"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.5",
    "happy-dom": "^20.9.0",
    "oxlint": "^1.47.0",
    "size-limit": "^11",
    "typescript": "^6.0.3",
    "vite": "^8.0.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "SignalX",
    "sigx",
    "actors",
    "virtual-actors",
    "orleans",
    "grains",
    "stateful"
  ],
  "author": "Andreas Ekdahl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/signalxjs/actors.git"
  },
  "homepage": "https://sigx.dev/actors/",
  "bugs": {
    "url": "https://github.com/signalxjs/actors/issues"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
