{
    "name": "sigx-actors-monorepo",
    "version": "0.1.0",
    "private": true,
    "description": "Virtual actors for SignalX",
    "type": "module",
    "scripts": {
        "sync:core": "node scripts/sync-core.mjs",
        "verify:catalog": "node scripts/check-catalog.mjs",
        "verify:refs": "node scripts/check-issue-refs.mjs",
        "wt": "node scripts/worktree.mjs",
        "branch-protection": "node scripts/apply-branch-protection.mjs",
        "build": "pnpm -r run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:workers": "pnpm --filter @sigx/actors-cloudflare test:workers",
        "test:coverage": "vitest run --coverage",
        "test:infra": "vitest run perf/aks/__tests__/infra.test.ts",
        "typecheck": "tsgo --noEmit && pnpm --filter @sigx/actors-cli typecheck && pnpm --filter @sigx/actors-dashboard typecheck && pnpm --filter cf-workers-example typecheck && pnpm --filter chat-example typecheck && pnpm --filter counter-example typecheck && pnpm --filter dashboard-example typecheck && pnpm --filter providers-example typecheck && pnpm --filter sigx-perf-aks typecheck && pnpm --filter sigx-perf-app typecheck",
        "lint": "oxlint packages/actors/src packages/actors-cli/src packages/actors-monitor/src packages/actors-dashboard/src packages/actors-pg/src packages/actors-sqlite/src packages/actors-surreal/src packages/actors-redis/src packages/actors-k8s/src packages/actors-otel/src packages/actors-cloudflare/src benchmarks/src examples/cf-workers/src examples/chat/src examples/counter/src examples/dashboard/src examples/providers/src perf/aks/src perf/app/src",
        "lint:fix": "oxlint --fix packages/actors/src packages/actors-cli/src packages/actors-monitor/src packages/actors-dashboard/src packages/actors-pg/src packages/actors-sqlite/src packages/actors-surreal/src packages/actors-redis/src packages/actors-k8s/src packages/actors-otel/src packages/actors-cloudflare/src benchmarks/src examples/cf-workers/src examples/chat/src examples/counter/src examples/dashboard/src examples/providers/src perf/aks/src perf/app/src",
        "bench": "pnpm build && pnpm bench:run",
        "bench:run": "node --conditions=production --expose-gc benchmarks/src/main.ts",
        "bench:dev-dist": "node --expose-gc benchmarks/src/main.ts",
        "bench:tier2": "cross-env BENCH_TIER2=1 node --conditions=production --expose-gc benchmarks/src/main.ts cluster2/ --no-gc-profile",
        "bench:threads": "cross-env BENCH_THREADS=1 node --conditions=production --expose-gc benchmarks/src/main.ts compute/ --no-gc-profile",
        "bench:baseline": "node --conditions=production --expose-gc benchmarks/src/main.ts --save-baseline",
        "bench:compare": "node --conditions=production --expose-gc benchmarks/src/main.ts --compare",
        "bench:infra": "cross-env BENCH_INFRA=1 node --conditions=production --expose-gc benchmarks/src/main.ts infra/",
        "bench:infra:baseline": "cross-env BENCH_INFRA=1 node --conditions=production --expose-gc benchmarks/src/main.ts infra/ --save-baseline",
        "bench:infra:compare": "cross-env BENCH_INFRA=1 node --conditions=production --expose-gc benchmarks/src/main.ts infra/ --compare",
        "bench:ws": "cross-env BENCH_WS=1 node --conditions=production --expose-gc benchmarks/src/main.ts sockets/ --runs=1",
        "bench:ws:baseline": "cross-env BENCH_WS=1 node --conditions=production --expose-gc benchmarks/src/main.ts sockets/ --runs=1 --save-baseline",
        "bench:ws:compare": "cross-env BENCH_WS=1 node --conditions=production --expose-gc benchmarks/src/main.ts sockets/ --runs=1 --compare",
        "bench:wf": "cross-env BENCH_WF=1 node --conditions=production --expose-gc benchmarks/src/main.ts workflow/ --runs=1 --no-warmup --no-gc-profile",
        "bench:wf:baseline": "cross-env BENCH_WF=1 node --conditions=production --expose-gc benchmarks/src/main.ts workflow/ --runs=1 --no-warmup --no-gc-profile --save-baseline",
        "bench:wf:compare": "cross-env BENCH_WF=1 node --conditions=production --expose-gc benchmarks/src/main.ts workflow/ --runs=1 --no-warmup --no-gc-profile --compare",
        "bench:diff": "node --conditions=production benchmarks/src/compare-files.ts",
        "bench:ab": "node --conditions=production --expose-gc benchmarks/src/ab.ts",
        "bench:ab:report": "node --conditions=production benchmarks/src/ab-report.ts",
        "bench:profile": "node --conditions=production --expose-gc --enable-source-maps --cpu-prof --cpu-prof-dir=benchmarks/profiles benchmarks/src/main.ts --runs=1",
        "clean": "rm -rf packages/*/dist packages/*/node_modules node_modules pnpm-lock.yaml",
        "publish:dry": "node scripts/publish.js --dry-run",
        "publish:all": "node scripts/publish.js",
        "publish:beta": "node scripts/publish.js --tag beta",
        "version:set": "node scripts/bump-version.js",
        "version:patch": "node scripts/bump-version.js patch",
        "version:minor": "node scripts/bump-version.js minor",
        "version:major": "node scripts/bump-version.js major",
        "verify:pack": "node scripts/verify-pack.js",
        "size": "size-limit"
    },
    "devDependencies": {
        "@size-limit/preset-small-lib": "^11",
        "@types/node": "^25.9.1",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@vitest/coverage-v8": "^4.1.11",
        "cross-env": "^10.1.0",
        "happy-dom": "^20.12.0",
        "oxlint": "^1.80.0",
        "size-limit": "^11",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "yaml": "^2.9.0"
    },
    "keywords": [
        "SignalX",
        "sigx",
        "actors",
        "virtual-actors",
        "actors",
        "stateful"
    ],
    "author": "Andreas Ekdahl",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/signalxjs/actors.git"
    },
    "homepage": "https://sigx.dev/actors/",
    "bugs": {
        "url": "https://github.com/signalxjs/actors/issues"
    },
    "packageManager": "pnpm@10.28.2",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
