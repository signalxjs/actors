        "@sigx/actors-ws": "workspace:*",
        "@sigx/reactivity": "catalog:",
        "@sigx/serialize": "catalog:",
        "@sigx/server": "catalog:",
        "ioredis": "^5.4.1",
        "undici": "^8.10.0",
        "ws": "^8.18.0"
    },
    "devDependencies": {
        "@sigx/actors-cli": "workspace:*",
        "@sigx/cli": "^0.9.0",
        "typescript": "^6.0.3"
    }
