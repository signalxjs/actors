        "@sigx/serialize": "catalog:",
        "@sigx/server": "catalog:",
        "ioredis": "^5.4.1",
        "undici": "^7.16.0"
    },
    "devDependencies": {
        "@sigx/actors-cli": "workspace:*",
        "@sigx/cli": "^0.9.0"
    }
